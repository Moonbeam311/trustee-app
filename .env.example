# Trustee App environment example

APP_ENV=production
FLASK_APP=app.py
FLASK_DEBUG=0

# Replace with a long random value in real deployment
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_KEY

# Optional runtime port if your host uses it
PORT=5000

# Railway/persistent storage paths
DB_PATH=/app/data/trustee_app.db
UPLOAD_FOLDER=/data/uploads
EXPORT_ROOT=/app/data/exports

# Hosted startup self-heal. Enable only when intentionally bootstrapping.
ENSURE_HOSTED_ADMIN=0
ENSURE_HOSTED_TEST_TRUST=0
ENSURE_HOSTED_PORTFOLIO_SEED=0
HOSTED_BOOTSTRAP_USERNAME=
HOSTED_BOOTSTRAP_PASSWORD=
HOSTED_BOOTSTRAP_FIRM_ID=FIRM-002

# Emergency repair routes. Keep disabled except during an operator-controlled repair.
HOSTED_RECOVERY_TOKEN=
ALLOW_HOSTED_ADMIN_BOOTSTRAP=0
ALLOW_HOSTED_FIRM_MIGRATION=0
ALLOW_HOSTED_PERMISSION_RESEED=0
ALLOW_HOSTED_LOGIN_UNLOCK=0
ALLOW_ADMIN_RESET=0
ALLOW_ADMIN_REPAIR_ROUTES=0
ALLOW_ADMIN_DIAGNOSTIC_SEED=0
